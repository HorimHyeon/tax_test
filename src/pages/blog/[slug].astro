---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, CATEGORIES } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const cat = CATEGORIES[d.category];
const url = new URL(`/blog/${post.id}/`, SITE.url).href;
const image = d.image ?? SITE.defaultImage;
const related = all
  .filter((p) => p.id !== post.id && p.data.category === d.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (x: Date) => x.toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long', day: 'numeric' });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    image: [new URL(image, SITE.url).href],
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    inLanguage: 'ko-KR',
    mainEntityOfPage: url,
    articleSection: cat.label,
    keywords: d.tags.join(', '),
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(`/blog/category/${d.category}/`, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.description} image={image} type="article"
  publishedTime={d.date.toISOString()} modifiedTime={(d.updated ?? d.date).toISOString()} tags={d.tags} jsonLd={jsonLd}>
  <main class="wrap">
    <article>
      <p class="meta"><a href="/blog/">블로그</a> › <a href={`/blog/category/${d.category}/`}>{cat.label}</a></p>
      <h1>{d.title}</h1>
      <p class="meta">{fmt(d.date)}{d.updated && ` · 수정 ${fmt(d.updated)}`}</p>
      {d.image && <img src={d.image} alt={d.imageAlt ?? d.title} style="width:100%;height:auto;border-radius:8px" />}
      <div class="prose"><Content /></div>
      <blockquote class="prose" style="background:var(--soft);border-left:4px solid var(--brand);margin:24px 0;padding:8px 16px">
        ※ 이 글은 일반적인 정보 제공을 위한 것입니다. 세법은 개정되는 경우가 많고 개별 상황에 따라 결과가 다를 수 있으니, 중요한 사안은 세무 전문가와 상담하세요.
      </blockquote>
    </article>

    <div class="cta">
      <strong>내 상황에 맞는 상담이 필요하신가요?</strong><br />
      <button type="button" class="btn" data-consult-open>상담 신청하기</button>
    </div>

    {related.length > 0 && (
      <>
        <h2>같은 카테고리의 다른 글</h2>
        <ul class="cards">{related.map((p) => <PostCard post={p} />)}</ul>
      </>
    )}
  </main>
</Base>
