---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="블로그 전체 글" description="부가가치세, 종합소득세, 법인세, 소상공인컨설팅, 정책자금 관련 전체 글 목록입니다.">
  <main class="wrap wide">
    <h1>블로그 전체 글</h1>
    <p class="meta">
      {Object.entries(CATEGORIES).map(([k, c]) => <a class="badge" href={`/blog/category/${k}/`}>{c.label}</a>)}
    </p>
    <ul class="cards">{posts.map((p) => <PostCard post={p} />)}</ul>
  </main>
</Base>
