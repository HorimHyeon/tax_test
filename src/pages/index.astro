---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, SERVICES, CATEGORIES } from '../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 6);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: SITE.nameEn, url: SITE.url, inLanguage: 'ko-KR', description: SITE.description },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, alternateName: SITE.nameEn, url: SITE.url, logo: SITE.url + SITE.logo, description: SITE.about },
];
---
<Base title={`${SITE.name} | ${SITE.tagline}`} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <div>
        <p class="eyebrow">{SITE.nameEn}</p>
        <h1>사장님의 가게를 아는<br /><em>실무형 경영 파트너</em></h1>
        <p class="lead">15년차 세무법인 사무장이자 직접 자영업을 운영하는 대표가, 소상공인에게 필요한 경영컨설팅·마케팅·AI개발 통합솔루션을 제공합니다.</p>
        <div class="actions">
          <button type="button" class="btn lg" data-consult-open>무료 상담 신청</button>
          <a class="btn ghost lg" href="/blog/">블로그 보기</a>
        </div>
      </div>
      <div class="emblem"><img src={SITE.logoMark} alt="범솔루션 호랑이 로고" width="236" height="300" /></div>
    </div>
  </section>

  <main>
    <section class="section" id="services">
      <div class="container">
        <div class="gold-bar"></div>
        <h2 class="title">범솔루션 서비스</h2>
        <p class="sub">{SITE.tagline}</p>
        <div class="strengths">
          {SERVICES.map((s) => <div class="strength"><b>{s.label}</b>{s.desc}</div>)}
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <div class="container about">
        <div>
          <div class="gold-bar"></div>
          <h2 class="title">범솔루션 소개</h2>
          <p class="sub">숫자와 현장, 두 가지를 모두 압니다.</p>
          <p>{SITE.about}</p>
          <p><a href="/about/">회사 소개 더 보기 →</a></p>
        </div>
        <ul class="facts">
          <li><strong>15년차 세무법인 사무장</strong>세무 현장에서 쌓은 실무 경험</li>
          <li><strong>소상공인 컨설팅 회사 대표</strong>경영 개선과 운영 고민까지 함께 해결</li>
          <li><strong>현직 자영업 운영자</strong>음식점 등 직접 운영하며 체감하는 사장님의 현실</li>
        </ul>
      </div>
    </section>

    <section class="section" id="topics">
      <div class="container">
        <div class="gold-bar"></div>
        <h2 class="title">블로그 주제</h2>
        <p class="sub">사장님께 필요한 세무·경영 정보를 분야별로 정리합니다.</p>
        <div class="grid">
          {Object.entries(CATEGORIES).map(([k, c]) => (
            <a class="tile" href={`/blog/category/${k}/`}><strong>{c.label}</strong><span>{c.desc}</span></a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="blog">
      <div class="container">
        <div class="gold-bar"></div>
        <h2 class="title">최신 블로그 글</h2>
        <p class="sub">바로 써먹을 수 있는 세무·경영 실무 정보를 업데이트합니다.</p>
        {latest.length ? <ul class="cards">{latest.map((p) => <PostCard post={p} />)}</ul> : <p>곧 새로운 글이 올라옵니다.</p>}
        <p class="more"><a href="/blog/">전체 글 보기 →</a></p>

        <div class="band">
          <strong>경영 고민, 혼자 끙끙 앓지 마세요</strong>
          <p>상황을 남겨 주시면 확인 후 연락드리겠습니다.</p>
          <button type="button" class="btn lg" data-consult-open>무료 상담 신청</button>
        </div>
      </div>
    </section>
  </main>
</Base>
